# disable ligatures
font-feature = -calt

keybind = cmd+l=new_split:right
keybind = cmd+h=new_split:left
keybind = cmd+k=new_split:up
keybind = cmd+j=new_split:down
keybind = cmd+shift+l=goto_split:right
keybind = cmd+shift+h=goto_split:left
keybind = cmd+shift+k=goto_split:top
keybind = cmd+shift+j=goto_split:bottom
keybind = cmd+shift+e=resize_split:up,300
keybind = cmd+shift+d=resize_split:down,300
keybind = cmd+shift+s=resize_split:left,300
keybind = cmd+shift+f=resize_split:right,300
keybind = shift+enter=text:\n
